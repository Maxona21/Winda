<Window x:Class="Winda.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Winda"
        mc:Ignorable="d"
        Title="Symulator Windy" Height="400" Width="800" Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="20" Orientation="Vertical" VerticalAlignment="Top">
            <TextBlock Text="Wybierz Piętrze" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="Black"/>
            
            <Button Command="{Binding CallFloorCommand}" CommandParameter="6" Height="50" Margin="0,5" Background="#4CAF50" Foreground="White" FontSize="16" FontWeight="Bold">6</Button>
            <Button Command="{Binding CallFloorCommand}" CommandParameter="5" Height="50" Margin="0,5" Background="#4CAF50" Foreground="White" FontSize="16" FontWeight="Bold">5</Button>
            <Button Command="{Binding CallFloorCommand}" CommandParameter="4" Height="50" Margin="0,5" Background="#4CAF50" Foreground="White" FontSize="16" FontWeight="Bold">4</Button>
            <Button Command="{Binding CallFloorCommand}" CommandParameter="3" Height="50" Margin="0,5" Background="#4CAF50" Foreground="White" FontSize="16" FontWeight="Bold">3</Button>
            <Button Command="{Binding CallFloorCommand}" CommandParameter="2" Height="50" Margin="0,5" Background="#4CAF50" Foreground="White" FontSize="16" FontWeight="Bold">2</Button>
            <Button Command="{Binding CallFloorCommand}" CommandParameter="1" Height="50" Margin="0,5" Background="#4CAF50" Foreground="White" FontSize="16" FontWeight="Bold">1</Button>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="20" Orientation="Vertical">
            <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="20">
                <StackPanel>
                    <TextBlock Text="Stan Windy" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="Black"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Piętrze:" FontSize="14" FontWeight="Bold" Width="100"/>
                        <TextBlock Text="{Binding CurrentFloor}" FontSize="14" Foreground="#2196F3" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Stan:" FontSize="14" FontWeight="Bold" Width="100"/>
                        <TextBlock Text="{Binding ElevatorStateText}" FontSize="14" Foreground="#FF9800" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Drzwi:" FontSize="14" FontWeight="Bold" Width="100"/>
                        <TextBlock Text="{Binding DoorStateText}" FontSize="14" Foreground="{Binding DoorStateColor}" FontWeight="Bold"/>
                    </StackPanel>

                    <TextBlock Text="Kolejka pięter:" FontSize="14" FontWeight="Bold" Margin="0,15,0,10"/>
                    <ListBox ItemsSource="{Binding FloorQueue}" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Height="80">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="Bold" Foreground="#1976D2" Margin="0,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
